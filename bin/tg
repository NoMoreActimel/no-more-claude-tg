#!/bin/sh
# Resolve symlinks by hand (readlink -f is missing on older macOS), then run the CLI with whichever node exists.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
for n in node /opt/homebrew/bin/node /usr/local/bin/node; do
  if command -v "$n" >/dev/null 2>&1; then
    exec "$n" "$root/src/cli.js" "$@"
  fi
done
echo "tg: node not found (install Node 22+ from https://nodejs.org)" >&2
exit 127
