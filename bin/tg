#!/bin/sh
# Resolve the repo through the ~/.local/bin symlink, then run the CLI with whichever node exists.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
root=$(cd "$(dirname "$self")/.." && pwd)
for n in node /opt/homebrew/bin/node /usr/local/bin/node; do
  if command -v "$n" >/dev/null 2>&1; then
    exec "$n" "$root/src/cli.js" "$@"
  fi
done
echo "tg: node not found" >&2
exit 127
